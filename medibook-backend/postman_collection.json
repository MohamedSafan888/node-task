{
  "info": {
    "name": "Online Course Platform API",
    "description": "Postman Collection for Online Course Platform RESTful API (Node.js + Express + Mongoose)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. John Smith\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Instructor\",\n  \"bio\": \"Expert instructor\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Hassan\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Student\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"omar@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses (with Search & Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/courses?search=React&category=Web Development&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                { "key": "search", "value": "React" },
                { "key": "category", "value": "Web Development" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/categories"
          }
        },
        {
          "name": "Get Single Course By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/<COURSE_ID>"
          }
        },
        {
          "name": "Create Course (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Node.js Microservices\",\n  \"description\": \"Build scalable and resilient microservices with Node.js and Docker.\",\n  \"category\": \"Web Development\",\n  \"price\": 79.99,\n  \"level\": \"Advanced\"\n}"
            },
            "url": "{{baseUrl}}/courses"
          }
        },
        {
          "name": "Update Course (Instructor)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Course Title\",\n  \"price\": 59.99\n}"
            },
            "url": "{{baseUrl}}/courses/<COURSE_ID>"
          }
        },
        {
          "name": "Delete Course (Instructor)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/courses/<COURSE_ID>"
          }
        },
        {
          "name": "Rate Course (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"review\": \"Outstanding course, learned so much!\"\n}"
            },
            "url": "{{baseUrl}}/courses/<COURSE_ID>/rate"
          }
        },
        {
          "name": "Enroll in Course (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/courses/<COURSE_ID>/enroll"
          }
        },
        {
          "name": "Get Course Students (Instructor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/courses/<COURSE_ID>/students"
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Get Lessons of a Course",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/<COURSE_ID>/lessons"
          }
        },
        {
          "name": "Get Lesson By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/lessons/<LESSON_ID>"
          }
        },
        {
          "name": "Create Lesson (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lesson 1: Getting Started\",\n  \"content\": \"In this lesson, we will cover the basics...\",\n  \"videoUrl\": \"https://youtube.com/watch?v=...\",\n  \"order\": 1,\n  \"duration\": 20\n}"
            },
            "url": "{{baseUrl}}/courses/<COURSE_ID>/lessons"
          }
        },
        {
          "name": "Update Lesson (Instructor)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Lesson Title\",\n  \"duration\": 30\n}"
            },
            "url": "{{baseUrl}}/lessons/<LESSON_ID>"
          }
        },
        {
          "name": "Delete Lesson (Instructor)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/lessons/<LESSON_ID>"
          }
        }
      ]
    },
    {
      "name": "Enrollments & Progress",
      "item": [
        {
          "name": "Get My Enrolled Courses (Student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/enrollments/my-courses"
          }
        },
        {
          "name": "Check Enrollment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/enrollments/<COURSE_ID>/status"
          }
        },
        {
          "name": "Toggle Lesson Progress (Student)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/enrollments/<COURSE_ID>/lessons/<LESSON_ID>/toggle"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get Comments for Lesson",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/lessons/<LESSON_ID>/comments"
          }
        },
        {
          "name": "Add Comment to Lesson",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Could you explain this concept in more detail?\"\n}"
            },
            "url": "{{baseUrl}}/lessons/<LESSON_ID>/comments"
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/comments/<COMMENT_ID>"
          }
        }
      ]
    }
  ]
}
